{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ParitySQL",
  "version": "0.1.0",
  "identifier": "com.sphelper.sqlhelptext",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ParitySQL",
        "dragDropEnabled": false,
        "width": 1200,
        "height": 740,
        "minWidth": 940,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDNDVFNEI5Mjk3QjZEMjMKUldRamJYc3B1ZVJGM1BTR2RvdktUTEpXK3ExRlBvQ0FBcWFiNlhSbmMxeHhSOEZkNVdtdEtPTTEK",
      "endpoints": [
        "https://github.com/josmad22/ParitySQL/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
